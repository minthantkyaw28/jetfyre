     def fit(self, tracks):
         X = pd.concat([features(t) for t in tracks], ignore_index=True)
         y = np.concatenate([target(t) for t in tracks])
-        self.m = lgb.LGBMRegressor(n_estimators=200, learning_rate=0.05, num_leaves=31,
